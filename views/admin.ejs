<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - WhatsApp AI Bot</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #4f46e5;
      --primary-dark: #4338ca;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-200: #e5e7eb;
      --gray-300: #d1d5db;
      --gray-400: #9ca3af;
      --gray-500: #6b7280;
      --gray-600: #4b5563;
      --gray-700: #374151;
      --gray-800: #1f2937;
      --gray-900: #111827;
      --white: #ffffff;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: var(--gray-50);
      color: var(--gray-900);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* Header */
    .header {
      background: var(--white);
      border-bottom: 1px solid var(--gray-200);
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      max-width: 1400px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logo h1 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--gray-900);
    }

    .logo-icon {
      font-size: 1.5rem;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .user-badge {
      padding: 0.5rem 1rem;
      background: var(--gray-100);
      border-radius: 0.5rem;
      font-size: 0.875rem;
      color: var(--gray-700);
    }

    /* Container */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--white);
      padding: 1.5rem;
      border-radius: 0.75rem;
      box-shadow: var(--shadow);
      border: 1px solid var(--gray-200);
    }

    .stat-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.75rem;
    }

    .stat-title {
      font-size: 0.875rem;
      color: var(--gray-600);
      font-weight: 500;
    }

    .stat-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    .stat-icon.primary { background: #eef2ff; }
    .stat-icon.success { background: #f0fdf4; }
    .stat-icon.warning { background: #fef3c7; }
    .stat-icon.info { background: #eff6ff; }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      color: var(--gray-900);
    }

    .stat-change {
      font-size: 0.75rem;
      color: var(--gray-500);
      margin-top: 0.25rem;
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--gray-200);
      overflow-x: auto;
    }

    .tab {
      padding: 0.75rem 1.5rem;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--gray-600);
      transition: all 0.2s;
      white-space: nowrap;
    }

    .tab:hover {
      color: var(--gray-900);
    }

    .tab.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
    }

    /* Tab Content */
    .tab-content {
      display: none;
    }

    .tab-content.active {
      display: block;
    }

    /* Card */
    .card {
      background: var(--white);
      border-radius: 0.75rem;
      box-shadow: var(--shadow);
      border: 1px solid var(--gray-200);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .card-header {
      margin-bottom: 1.5rem;
    }

    .card-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--gray-900);
      margin-bottom: 0.25rem;
    }

    .card-subtitle {
      font-size: 0.875rem;
      color: var(--gray-500);
    }

    /* Form */
    .form-grid {
      display: grid;
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }

    label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--gray-700);
    }

    input, select, textarea {
      width: 100%;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--gray-300);
      border-radius: 0.5rem;
      font-size: 0.875rem;
      transition: all 0.2s;
      font-family: inherit;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
    }

    textarea {
      resize: vertical;
      min-height: 100px;
    }

    .hint {
      font-size: 0.75rem;
      color: var(--gray-500);
    }

    /* Toggle Switch */
    .toggle-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: var(--gray-50);
      border-radius: 0.5rem;
    }

    .toggle-info {
      flex: 1;
    }

    .toggle-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--gray-700);
      display: block;
      margin-bottom: 0.25rem;
    }

    .toggle-switch {
      position: relative;
      width: 44px;
      height: 24px;
    }

    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--gray-300);
      transition: 0.3s;
      border-radius: 24px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 18px;
      width: 18px;
      left: 3px;
      bottom: 3px;
      background-color: white;
      transition: 0.3s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--primary);
    }

    input:checked + .slider:before {
      transform: translateX(20px);
    }

    /* Buttons */
    .btn {
      padding: 0.625rem 1.25rem;
      border: none;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: inherit;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .btn-secondary {
      background: var(--gray-200);
      color: var(--gray-700);
    }

    .btn-secondary:hover {
      background: var(--gray-300);
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    .btn-group {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    /* Table */
    .table-container {
      overflow-x: auto;
      margin-top: 1rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      padding: 0.75rem;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--gray-600);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--gray-200);
    }

    td {
      padding: 1rem 0.75rem;
      font-size: 0.875rem;
      color: var(--gray-700);
      border-bottom: 1px solid var(--gray-100);
    }

    tr:hover {
      background: var(--gray-50);
    }

    /* Badge */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.625rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .badge-success {
      background: #d1fae5;
      color: #065f46;
    }

    .badge-info {
      background: #dbeafe;
      color: #1e40af;
    }

    /* Alert */
    .alert {
      padding: 1rem;
      border-radius: 0.5rem;
      margin-bottom: 1rem;
      display: none;
    }

    .alert.show {
      display: block;
    }

    .alert-success {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #6ee7b7;
    }

    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }

    /* Loading */
    .loading {
      display: inline-block;
      width: 1rem;
      height: 1rem;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.6s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--gray-500);
    }

    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .container {
        padding: 1rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .form-row {
        grid-template-columns: 1fr;
      }

      .btn-group {
        flex-direction: column;
      }

      .btn {
        width: 100%;
        justify-content: center;
      }
    }

    /* Connection Status Badge */
    .connection-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .connection-badge.connected {
      background: #d1fae5;
      color: #065f46;
    }

    .connection-badge.disconnected {
      background: #fee2e2;
      color: #991b1b;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .connection-badge.connected .status-dot {
      background: #10b981;
    }

    .connection-badge.disconnected .status-dot {
      background: #ef4444;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    /* Logs Container */
    .logs-container {
      max-height: 500px;
      overflow-y: auto;
      background: var(--gray-900);
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
      font-size: 0.813rem;
      line-height: 1.5;
    }

    .log-entry {
      padding: 0.5rem 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      gap: 0.75rem;
      color: var(--gray-300);
    }

    .log-entry:hover {
      background: rgba(255, 255, 255, 0.02);
    }

    .log-time {
      color: var(--gray-500);
      flex-shrink: 0;
    }

    .log-source {
      color: var(--gray-400);
      flex-shrink: 0;
      min-width: 100px;
    }

    .log-message {
      flex: 1;
      word-break: break-word;
    }

    .log-info { border-left: 3px solid #3b82f6; }
    .log-info .log-message { color: #93c5fd; }

    .log-success { border-left: 3px solid #10b981; }
    .log-success .log-message { color: #6ee7b7; }

    .log-warn { border-left: 3px solid #f59e0b; }
    .log-warn .log-message { color: #fbbf24; }

    .log-error { border-left: 3px solid #ef4444; }
    .log-error .log-message { color: #f87171; }

    .log-debug { border-left: 3px solid #6b7280; }
    .log-debug .log-message { color: #9ca3af; }

    .log-empty {
      color: var(--gray-500);
      justify-content: center;
      padding: 2rem 1rem;
    }
    .log-empty .log-message { color: var(--gray-500); }

    /* Logs header + toolbar */
    .logs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .logs-toolbar {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .logs-input {
      width: auto;
      padding: 0.5rem 0.75rem;
      font-size: 0.813rem;
      border: 1px solid var(--gray-300);
      border-radius: 0.5rem;
      background: var(--white);
    }

    #log-search { min-width: 180px; }

    .btn-sm {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }

    .btn-outline {
      background: var(--white);
      color: var(--gray-700);
      border: 1px solid var(--gray-300);
    }

    .btn-outline:hover {
      background: var(--gray-50);
    }

    .log-hidden { display: none !important; }

    /* ---------------------------------------------------------------
       Analytics charts

       Chart roles are declared once here so a future dark mode is a
       single-block swap. The series hue (#4f46e5, the app's brand
       indigo) is validated against the white card surface: it clears
       the lightness band, chroma floor and 3:1 contrast gates.
       Every chart plots ONE series, so colour never carries identity.
       --------------------------------------------------------------- */
    :root {
      --chart-surface: var(--white);
      --chart-series-1: #4f46e5;
      --chart-grid: var(--gray-200);
      --chart-axis-text: var(--gray-500);
      --chart-ink: var(--gray-900);
      --chart-ink-secondary: var(--gray-600);
      --chart-delta-up: #006300;
      --chart-delta-down: #d03b3b;
    }

    /* Filter row — scopes everything below it */
    .filter-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .filter-label {
      font-size: 0.813rem;
      font-weight: 600;
      color: var(--gray-600);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .range-group {
      display: inline-flex;
      background: var(--gray-100);
      border-radius: 0.5rem;
      padding: 0.25rem;
      gap: 0.25rem;
    }

    .range-btn {
      padding: 0.375rem 0.875rem;
      border: none;
      background: transparent;
      border-radius: 0.375rem;
      font-size: 0.813rem;
      font-weight: 500;
      color: var(--gray-600);
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
    }

    .range-btn:hover { color: var(--gray-900); }

    .range-btn.active {
      background: var(--white);
      color: var(--primary);
      box-shadow: var(--shadow-sm);
    }

    #analytics-content { transition: opacity 0.15s; }
    /* Refetch holds the previous render — no skeleton, no layout jump */
    #analytics-content.is-loading { opacity: 0.5; }

    .chart-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .chart-grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .chart-host {
      position: relative;
      width: 100%;
      overflow: visible;
    }

    .chart-svg { display: block; width: 100%; overflow: visible; }

    /* Marks: thin, with the data as the only loud thing */
    .chart-line {
      fill: none;
      stroke: var(--chart-series-1);
      stroke-width: 2;
      stroke-linejoin: round;
      stroke-linecap: round;
    }

    .chart-area { fill: var(--chart-series-1); opacity: 0.1; }

    .chart-bar { fill: var(--chart-series-1); transition: opacity 0.12s; }
    .chart-bar.is-hover { opacity: 0.78; }

    .chart-dot {
      fill: var(--chart-series-1);
      /* 2px surface ring keeps the marker legible where it crosses the line */
      stroke: var(--chart-surface);
      stroke-width: 2;
    }

    .chart-dot-hover {
      fill: var(--chart-series-1);
      stroke: var(--chart-surface);
      stroke-width: 2;
      pointer-events: none;
    }

    /* Chrome recedes: solid hairlines, never dashed */
    .chart-grid { stroke: var(--chart-grid); stroke-width: 1; }

    .chart-crosshair {
      stroke: var(--gray-400);
      stroke-width: 1;
      pointer-events: none;
    }

    /* Text wears text tokens, never the series colour */
    .chart-axis-label {
      fill: var(--chart-axis-text);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }

    .chart-row-label { fill: var(--chart-ink-secondary); font-size: 12px; }

    .chart-value-label {
      fill: var(--chart-ink);
      font-size: 12px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .chart-hit, .chart-overlay { cursor: crosshair; }
    .chart-overlay:focus { outline: none; }
    .chart-overlay:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

    /* Tooltip: value leads, label follows */
    .chart-tooltip {
      position: absolute;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.12s;
      background: var(--gray-900);
      color: var(--white);
      border-radius: 0.5rem;
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
      z-index: 20;
      box-shadow: var(--shadow-md);
    }

    .chart-tooltip.visible { opacity: 1; }

    .chart-tooltip-title {
      color: var(--gray-400);
      margin-bottom: 0.25rem;
      font-size: 0.688rem;
    }

    .chart-tooltip-row { display: flex; align-items: center; gap: 0.375rem; }

    /* A short stroke keys the series — a filled box would be data-weight ink */
    .chart-tooltip-key {
      width: 10px;
      height: 2px;
      background: var(--chart-series-1);
      border-radius: 1px;
      flex-shrink: 0;
    }

    .chart-tooltip-value { font-variant-numeric: tabular-nums; }
    .chart-tooltip-label { color: var(--gray-400); }

    .chart-empty { text-align: center; padding: 3rem 1rem; color: var(--gray-500); }
    .chart-empty-icon { font-size: 2rem; margin-bottom: 0.5rem; }

    /* Table view — the WCAG-clean twin of every chart */
    .chart-table { width: 100%; border-collapse: collapse; }
    .chart-table th {
      text-align: left;
      padding: 0.5rem 0.75rem;
      font-size: 0.688rem;
      color: var(--gray-600);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--gray-200);
    }
    .chart-table td {
      padding: 0.5rem 0.75rem;
      font-size: 0.813rem;
      color: var(--gray-700);
      border-bottom: 1px solid var(--gray-100);
    }
    .chart-table td.num { text-align: right; font-variant-numeric: tabular-nums; }

    .delta-up { color: var(--chart-delta-up); font-weight: 600; }
    .delta-down { color: var(--chart-delta-down); font-weight: 600; }
    .delta-flat { color: var(--gray-500); font-weight: 600; }

    /* Personality modes */
    .pill {
      display: inline-block;
      padding: 0.0625rem 0.375rem;
      border-radius: 0.25rem;
      font-size: 0.625rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #eef2ff;
      color: var(--primary);
      vertical-align: middle;
      margin-left: 0.25rem;
    }

    .pill-warn { background: #fef3c7; color: #92400e; }

    .mode-callout {
      padding: 0.875rem 1rem;
      background: #eef2ff;
      border: 1px solid #c7d2fe;
      border-radius: 0.5rem;
      font-size: 0.813rem;
      color: var(--gray-700);
      line-height: 1.5;
    }

    .mode-select {
      width: auto;
      min-width: 150px;
      padding: 0.375rem 0.5rem;
      font-size: 0.75rem;
      border: 1px solid var(--gray-300);
      border-radius: 0.375rem;
      background: var(--white);
      cursor: pointer;
    }

    /* People & Memory panels */
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.75rem 1.5rem;
      margin-bottom: 0.5rem;
    }

    .detail-row {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--gray-100);
    }

    .detail-label {
      font-size: 0.688rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--gray-500);
      font-weight: 600;
    }

    .detail-value {
      font-size: 0.875rem;
      color: var(--gray-900);
      word-break: break-word;
    }

    .detail-heading {
      font-size: 0.938rem;
      font-weight: 600;
      color: var(--gray-900);
      margin: 1.5rem 0 0.75rem;
    }

    .muted-note { color: var(--gray-500); font-size: 0.875rem; }

    .mono-cell {
      font-family: 'Monaco', 'Menlo', 'Consolas', monospace;
      font-size: 0.75rem;
      background: var(--gray-100);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
    }

    .badge + .badge { margin-left: 0.25rem; }

    .message-list { display: flex; flex-direction: column; gap: 0.5rem; }

    .message-item {
      padding: 0.75rem;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: 0.5rem;
    }

    .message-meta {
      font-size: 0.688rem;
      color: var(--gray-500);
      margin-bottom: 0.25rem;
    }

    .message-text { font-size: 0.875rem; color: var(--gray-800); word-break: break-word; }

    .inline-warning {
      padding: 0.75rem 1rem;
      background: #fef3c7;
      border: 1px solid #fcd34d;
      color: #92400e;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .memory-item {
      padding: 0.75rem 1rem;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .memory-meta {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      font-size: 0.75rem;
      color: var(--gray-600);
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
    }

    .memory-score {
      font-weight: 700;
      color: var(--primary);
      font-variant-numeric: tabular-nums;
      background: #eef2ff;
      padding: 0.125rem 0.5rem;
      border-radius: 0.25rem;
    }

    .memory-text {
      font-family: inherit;
      font-size: 0.813rem;
      color: var(--gray-700);
      white-space: pre-wrap;
      word-break: break-word;
      margin: 0;
      max-height: 180px;
      overflow-y: auto;
    }

    /* Access Control Lists */
    .access-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .access-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: 0.5rem;
      transition: all 0.2s;
    }

    .access-item:hover {
      background: var(--white);
      border-color: var(--gray-300);
      box-shadow: var(--shadow-sm);
    }

    .access-item-info {
      flex: 1;
    }

    .access-item-id {
      font-family: monospace;
      font-size: 0.875rem;
      color: var(--gray-900);
      font-weight: 500;
    }

    .access-item-meta {
      display: flex;
      gap: 0.75rem;
      margin-top: 0.25rem;
      font-size: 0.813rem;
      color: var(--gray-600);
    }

    .access-item-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.125rem 0.5rem;
      border-radius: 0.25rem;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .access-item-badge.contact {
      background: #dbeafe;
      color: #1e40af;
    }

    .access-item-badge.group {
      background: #fef3c7;
      color: #92400e;
    }

    .btn-remove {
      padding: 0.5rem 1rem;
      background: var(--danger);
      color: var(--white);
      border: none;
      border-radius: 0.375rem;
      cursor: pointer;
      font-size: 0.875rem;
      transition: all 0.2s;
    }

    .btn-remove:hover {
      background: #dc2626;
    }

    /* Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      background: var(--white);
      border-radius: 0.75rem;
      box-shadow: var(--shadow-lg);
      max-width: 500px;
      width: 90%;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--gray-200);
    }

    .modal-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--gray-900);
    }

    .modal-body {
      padding: 1.5rem;
    }

    .modal-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--gray-200);
      display: flex;
      gap: 0.75rem;
      justify-content: flex-end;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="header-content">
      <div class="logo">
        <span class="logo-icon">🤖</span>
        <h1>WhatsApp AI Bot</h1>
      </div>
      <div class="header-actions">
        <div class="user-badge">Admin</div>
        <button class="btn btn-secondary" onclick="logout()">Logout</button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container">
    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-header">
          <div>
            <div class="stat-title">Total Messages</div>
          </div>
          <div class="stat-icon primary">💬</div>
        </div>
        <div class="stat-value" id="stat-messages">-</div>
        <div class="stat-change">Database records</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div>
            <div class="stat-title">Total Users</div>
          </div>
          <div class="stat-icon success">👥</div>
        </div>
        <div class="stat-value" id="stat-users">-</div>
        <div class="stat-change"><span id="stat-active-users">-</span> active today</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div>
            <div class="stat-title">Conversations</div>
          </div>
          <div class="stat-icon warning">💭</div>
        </div>
        <div class="stat-value" id="stat-conversations">-</div>
        <div class="stat-change">Active chats</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div>
            <div class="stat-title">Today's Activity</div>
          </div>
          <div class="stat-icon info">📊</div>
        </div>
        <div class="stat-value" id="stat-today-messages">-</div>
        <div class="stat-change">Messages today</div>
      </div>
    </div>

    <!-- WhatsApp Connection Status Card -->
    <div class="card" id="whatsapp-status-card" style="margin-top: 1.5rem;">
      <div class="card-header">
        <div>
          <h2 class="card-title">WhatsApp Connection & Bot Control</h2>
          <p class="card-subtitle">Connection status, QR code, and bot controls</p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <div id="connection-status-home" class="connection-badge disconnected">
            <span class="status-dot"></span>
            <span class="status-text">Disconnected</span>
          </div>
        </div>
      </div>
      <div class="card-body">
        <!-- Bot Control Toggle -->
        <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--gray-50); border-radius: 0.5rem; border: 1px solid var(--gray-200);">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.25rem;">Bot Status</h3>
              <p style="font-size: 0.875rem; color: var(--gray-600);">
                <span id="bot-status-text">Bot is currently OFF</span>
              </p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button id="btn-start-bot" class="btn btn-primary" onclick="toggleBot(true)" style="display: none;">
                ▶️ Start Bot
              </button>
              <button id="btn-stop-bot" class="btn btn-secondary" onclick="toggleBot(false)" style="display: none;">
                ⏸️ Stop Bot
              </button>
            </div>
          </div>
        </div>

        <!-- Access Control Mode Selector -->
        <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--gray-50); border-radius: 0.5rem; border: 1px solid var(--gray-200);">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.25rem;">🔒 Access Control</h3>
              <p style="font-size: 0.875rem; color: var(--gray-600);">
                <span id="access-mode-text">Current mode: <strong id="access-mode-value">Loading...</strong></span>
              </p>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <select id="access-control-mode-select" onchange="updateAccessMode()" style="padding: 0.5rem 1rem; border: 2px solid var(--gray-300); border-radius: 0.5rem; font-size: 0.875rem; background: white; color: var(--gray-900); cursor: pointer;">
                <option value="disabled">🌍 Free Mode (Allow All)</option>
                <option value="whitelist">✅ Whitelist Only</option>
                <option value="blacklist">⛔ Block Blacklisted</option>
              </select>
              <button class="btn btn-secondary" onclick="switchTab('access')" style="padding: 0.5rem 1rem; font-size: 0.875rem;">
                ⚙️ Manage Lists
              </button>
            </div>
          </div>
        </div>

        <!-- Group Response Mode Selector -->
        <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--gray-50); border-radius: 0.5rem; border: 1px solid var(--gray-200);">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h3 style="font-size: 1rem; font-weight: 600; color: var(--gray-900); margin-bottom: 0.25rem;">💬 Group Response Mode</h3>
              <p style="font-size: 0.875rem; color: var(--gray-600);">
                <span id="group-mode-text">Current mode: <strong id="group-mode-value">Loading...</strong></span>
              </p>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <select id="group-response-mode-select" onchange="updateGroupResponseMode()" style="padding: 0.5rem 1rem; border: 2px solid var(--gray-300); border-radius: 0.5rem; font-size: 0.875rem; background: white; color: var(--gray-900); cursor: pointer;">
                <option value="mention-only">🏷️ Only When Tagged</option>
                <option value="contextual">🤖 Smart/Contextual (AI decides)</option>
                <option value="all">💬 Reply to All Messages</option>
              </select>
            </div>
          </div>
          <div style="margin-top: 0.75rem; padding: 0.75rem; background: var(--gray-100); border-radius: 0.375rem; font-size: 0.813rem; color: var(--gray-700);">
            <strong>Modes:</strong><br>
            • <strong>Only When Tagged:</strong> Bot responds only when mentioned/tagged in group<br>
            • <strong>Smart/Contextual:</strong> AI decides when to join conversation naturally<br>
            • <strong>Reply to All:</strong> Bot responds to every message in group
          </div>
        </div>

        <div id="qr-container-home" style="display: none;">
          <p style="margin-bottom: 1rem; color: var(--gray-600);">Scan this QR code with WhatsApp:</p>
          <div style="text-align: center; padding: 1rem; background: var(--gray-50); border-radius: 0.5rem; border: 1px solid var(--gray-200);">
            <img id="qr-image-home" src="" alt="QR Code" style="max-width: 350px; width: 100%;">
          </div>
          <p style="margin-top: 1rem; color: var(--gray-500); font-size: 0.875rem; text-align: center;">
            📲 Open WhatsApp → Settings → Linked Devices → Link a Device
          </p>
        </div>
        <div id="connected-info-home" style="display: none;">
          <p style="color: var(--success); font-weight: 500; font-size: 0.938rem;">
            ✅ Connected as: <span id="phone-number-home" style="font-family: monospace;">-</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Alert -->
    <div class="alert alert-success" id="alert-success"></div>
    <div class="alert alert-error" id="alert-error"></div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" onclick="switchTab('settings')">⚙️ Settings</button>
      <button class="tab" onclick="switchTab('access')">🔒 Access Control</button>
      <button class="tab" onclick="switchTab('conversations')">💬 Conversations</button>
      <button class="tab" onclick="switchTab('people')">👤 People</button>
      <button class="tab" onclick="switchTab('knowledge')">🧠 Memory</button>
      <button class="tab" onclick="switchTab('analytics')">📊 Analytics</button>
      <button class="tab" onclick="switchTab('logs')">📋 Logs</button>
    </div>

    <!-- Settings Tab -->
    <div class="tab-content active" id="tab-settings">
      <form id="settingsForm" onsubmit="saveSettings(event)">
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Bot Configuration</h2>
            <p class="card-subtitle">Configure bot name, admin numbers, and rate limiting</p>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Bot Name (Mention Trigger)</label>
              <input type="text" name="botName" value="<%= runtime.botName %>" required>
              <span class="hint">Users mention this name to trigger the bot (e.g., @bot)</span>
            </div>

            <div class="form-group">
              <label>Admin Phone Numbers</label>
              <input type="text" name="adminNumbers" value="<%= (runtime.adminNumbers || []).join(',') %>" placeholder="1234567890,9876543210">
              <span class="hint">Comma-separated, digits only (no + or spaces)</span>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Rate Limit (requests)</label>
                <input type="number" name="rateLimitMaxRequests" value="<%= runtime.rateLimitMaxRequests %>" min="1" required>
              </div>
              <div class="form-group">
                <label>Rate Window (ms)</label>
                <input type="number" name="rateLimitWindowMs" value="<%= runtime.rateLimitWindowMs %>" min="1000" required>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">AI Configuration</h2>
            <p class="card-subtitle">Configure LLM provider, API keys, and system prompt</p>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>LLM Provider</label>
              <select name="llmProvider" id="llmProvider" onchange="toggleProvider()">
                <option value="gemini" <%= (runtime.llmProvider || 'gemini') === 'gemini' ? 'selected' : '' %>>Google Gemini</option>
                <option value="openai" <%= runtime.llmProvider === 'openai' ? 'selected' : '' %>>OpenAI / DigitalOcean / DeepSeek</option>
              </select>
            </div>

            <div id="gemini-config">
              <div class="form-group">
                <label>Gemini API Key</label>
                <input type="password" name="geminiApiKey" value="<%= runtime.geminiApiKey || '' %>" autocomplete="off">
                <span class="hint">Get from https://ai.google.dev/</span>
              </div>
            </div>

            <div id="openai-config" style="display: none;">
              <div class="form-row">
                <div class="form-group">
                  <label>API Key</label>
                  <input type="password" name="openaiApiKey" value="<%= runtime.openaiApiKey || '' %>" autocomplete="off">
                </div>
                <div class="form-group">
                  <label>Model</label>
                  <input type="text" name="openaiModel" value="<%= runtime.openaiModel || 'gpt-4o-mini' %>">
                </div>
              </div>
              <div class="form-group">
                <label>Base URL (Optional)</label>
                <input type="text" name="openaiBaseUrl" value="<%= runtime.openaiBaseUrl || '' %>" placeholder="https://inference.do-ai.run/v1/">
                <span class="hint">For DigitalOcean: https://inference.do-ai.run/v1/ | DeepSeek: https://api.deepseek.com</span>
              </div>
            </div>

          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Personality modes</h2>
            <p class="card-subtitle">
              Each mode has its own prompt, so switching a chat swaps the whole voice.
              Any chat can override the default from the Conversations tab or with
              <code>!mode assistant|companion</code>. Changes apply to the next message.
            </p>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Default mode</label>
              <select name="defaultPersona" id="defaultPersona">
                <option value="assistant" <%= (runtime.defaultPersona || 'assistant') === 'assistant' ? 'selected' : '' %>>🎯 Assistant — concise and task-focused</option>
                <option value="companion" <%= runtime.defaultPersona === 'companion' ? 'selected' : '' %>>💬 Companion — conversational, joins in when it fits</option>
              </select>
              <span class="hint">Applies to any chat without its own override.</span>
            </div>

            <div class="mode-callout">
              <strong>Companion mode is proactive.</strong> In groups it decides for itself when a
              message is worth joining, so it does not wait to be tagged — the Group Response Mode
              setting above does not apply to chats using it. It can also reply with just an emoji
              reaction when a message deserves acknowledgement but not a full answer.
            </div>

            <div class="form-group">
              <label>🎯 Assistant prompt</label>
              <textarea name="assistantPrompt" rows="6" placeholder="Leave blank to use the built-in default"><%= runtime.assistantPrompt || '' %></textarea>
              <span class="hint">Blank uses the built-in default (short, clear, task-focused).</span>
            </div>

            <div class="form-group">
              <label>💬 Companion prompt</label>
              <textarea name="companionPrompt" rows="10" placeholder="Leave blank to use the built-in default"><%= runtime.companionPrompt || '' %></textarea>
              <span class="hint">
                Blank uses the built-in default, which matches the group's tone, keeps replies
                short, and stays honest if someone sincerely asks whether it's a bot.
              </span>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Adaptive style <span class="pill">Companion</span></label>
                <span class="hint">
                  Reads how each chat actually writes — message length, emoji use, lowercase habits,
                  shorthand, language — and tells the bot to match that register. Computed from stored
                  messages, so it costs no extra API calls.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="companionAdaptiveStyle" <%= runtime.companionAdaptiveStyle !== false ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Free mode <span class="pill pill-warn">Companion</span></label>
                <span class="hint">
                  Talks like a close friend: swearing, dark humour, sarcasm and real opinions, with no
                  disclaimers, hedging or moralising. It still reads the room — it drops the banter when
                  someone is genuinely upset. Note that your AI provider applies its own limits on top of
                  this, which no prompt can change.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="companionFreeMode" <%= runtime.companionFreeMode ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="form-group">
              <label>Maximum reply length <span class="pill">Companion</span></label>
              <input type="number" name="companionMaxChars" min="0" max="4000" value="<%= runtime.companionMaxChars === undefined ? 350 : runtime.companionMaxChars %>">
              <span class="hint">
                Characters. Enforced twice: the model gets a matching token budget, and anything still
                over is trimmed on a sentence boundary. <strong>0 = no limit.</strong> 350 ≈ two chat
                sentences. Assistant mode is never capped.
              </span>
            </div>

            <div class="form-group">
              <label>How much it joins in <span class="pill">Companion</span></label>
              <select name="companionChattiness">
                <option value="selective" <%= (runtime.companionChattiness || 'selective') === 'selective' ? 'selected' : '' %>>Selective — about 1 message in 10 is the bot</option>
                <option value="present" <%= runtime.companionChattiness === 'present' ? 'selected' : '' %>>Present — about 1 in 5</option>
                <option value="talkative" <%= runtime.companionChattiness === 'talkative' ? 'selected' : '' %>>Talkative — about 1 in 3</option>
              </select>
              <span class="hint">
                A ceiling on the bot's share of a chat. When it has been talking too much
                it stays quiet, even if a reply would have been reasonable. Override per
                chat from the Conversations tab or with <code>!chattiness</code>.
              </span>
            </div>

            <div class="mode-callout">
              <strong>How it decides when to speak.</strong> Rather than judging every message
              the instant it arrives, Companion waits for the conversation to settle — longer
              when a chat is busy, shorter when it is quiet — then considers the whole burst at
              once. That is why several messages can go by before it answers, the same way a
              person reads a few messages and replies to the thread. It also means a rapid
              burst costs one AI call instead of one per message. Being @mentioned always gets
              a prompt reply.
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Human delivery <span class="pill">Companion</span></label>
                <span class="hint">
                  Pauses to "read", holds the typing indicator for as long as the reply would
                  actually take to type, sends longer replies as two or three messages, and
                  only quotes when the thread has moved on. Turn off to send instantly in one
                  message.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="humanTiming" <%= runtime.humanTiming !== false ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Occasional late replies <span class="pill">Companion</span></label>
                <span class="hint">
                  Sometimes answers a minute or two later, like someone who put their phone
                  down. Off by default — it will occasionally reply to a moment that has passed.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="companionLateReplies" <%= runtime.companionLateReplies ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Emoji reactions</label>
                <span class="hint">
                  Assistant uses 👀. Companion picks an emoji that fits — chosen by the same call
                  that decides whether to reply, so it costs no extra request.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="emojiReactions" <%= runtime.emojiReactions !== false ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Chat Behavior</h2>
            <p class="card-subtitle">Control how the bot responds in different contexts</p>
          </div>

          <div class="form-grid">
            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Private Chat Responses</label>
                <span class="hint">Bot responds to all private messages</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="enablePrivateChat" <%= runtime.enablePrivateChat ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Group Message Responses</label>
                <span class="hint">Bot responds to group messages even without mention</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="respondToGroupMessages" <%= runtime.respondToGroupMessages ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Contextual Group Responses</label>
                <span class="hint">AI decides when to jump into group conversations</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="contextualGroupResponses" <%= runtime.contextualGroupResponses ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Access Control Mode</label>
                <select name="accessControlMode">
                  <option value="disabled" <%= (runtime.accessControlMode || 'disabled') === 'disabled' ? 'selected' : '' %>>Disabled (Allow All)</option>
                  <option value="whitelist" <%= runtime.accessControlMode === 'whitelist' ? 'selected' : '' %>>Whitelist (Only Allowed)</option>
                  <option value="blacklist" <%= runtime.accessControlMode === 'blacklist' ? 'selected' : '' %>>Blacklist (Block Specific)</option>
                </select>
                <span class="hint">Control which contacts/groups can interact with the bot</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Memory &amp; Recall</h2>
            <p class="card-subtitle">
              Short-term memory is the recent conversation sent with every prompt. Long-term
              recall searches all past messages by meaning and adds only the relevant parts,
              which keeps token use low without limiting how far back the bot can remember.
            </p>
          </div>

          <div class="form-grid">
            <div class="form-row">
              <div class="form-group">
                <label>Recent messages kept per chat</label>
                <input type="number" name="memoryMessageLimit" min="0" value="<%= runtime.memoryMessageLimit %>">
                <span class="hint">Sent with every prompt. <strong>0 = unlimited</strong> (raises token cost on busy chats).</span>
              </div>
              <div class="form-group">
                <label>Short-term memory window (ms)</label>
                <input type="number" name="memoryWindowMs" min="0" value="<%= runtime.memoryWindowMs %>">
                <span class="hint"><strong>0 = never expires.</strong> 3600000 = 1 hour, 86400000 = 1 day.</span>
              </div>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Long-term recall (RAG)</label>
                <span class="hint">Let the bot search all past conversations by meaning</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="ragEnabled" <%= runtime.ragEnabled !== false ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Recall across different chats</label>
                <span class="hint">⚠️ Off by default: when on, something said in one group can surface in another</span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="ragCrossChat" <%= runtime.ragCrossChat ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Memories per reply</label>
                <input type="number" name="ragTopK" min="1" max="20" value="<%= runtime.ragTopK || 4 %>">
                <span class="hint">How many recalled chunks to include (1-20)</span>
              </div>
              <div class="form-group">
                <label>Relevance threshold</label>
                <input type="number" name="ragMinScore" min="0" max="1" step="0.05" value="<%= runtime.ragMinScore === undefined ? 0.3 : runtime.ragMinScore %>">
                <span class="hint">0-1. Higher = stricter; below this a memory is ignored.</span>
              </div>
              <div class="form-group">
                <label>Embedding model (optional)</label>
                <input type="text" name="embeddingModel" value="<%= runtime.embeddingModel || '' %>" placeholder="provider default">
                <span class="hint">Blank uses the default. Changing this requires a rebuild in the Memory tab.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Usage limits</h2>
            <p class="card-subtitle">
              The bot is driven by whoever is in the chat, so without a ceiling a busy group can
              run up an unbounded provider bill. Limits are in <strong>tokens</strong>, which is what
              providers actually report — a price list would drift out of date.
            </p>
          </div>

          <div class="form-grid">
            <div class="toggle-group">
              <div class="toggle-info">
                <label class="toggle-label">Enforce usage limits</label>
                <span class="hint">
                  When a limit is reached the bot stops calling the AI and says so, instead of
                  failing silently. Admin commands keep working.
                </span>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" name="budgetEnabled" <%= runtime.budgetEnabled ? 'checked' : '' %>>
                <span class="slider"></span>
              </label>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Daily token limit</label>
                <input type="number" name="dailyTokenLimit" min="0" value="<%= runtime.dailyTokenLimit || 0 %>">
                <span class="hint"><strong>0 = no limit.</strong> Resets at midnight.</span>
              </div>
              <div class="form-group">
                <label>Monthly token limit</label>
                <input type="number" name="monthlyTokenLimit" min="0" value="<%= runtime.monthlyTokenLimit || 0 %>">
                <span class="hint"><strong>0 = no limit.</strong> Calendar month.</span>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Price per 1M tokens (optional)</label>
                <input type="number" name="costPerMillionTokens" min="0" step="0.01" value="<%= runtime.costPerMillionTokens || 0 %>">
                <span class="hint">Display only — turns token counts into an estimated cost. 0 hides it.</span>
              </div>
              <div class="form-group">
                <label>Currency label</label>
                <input type="text" name="costCurrency" value="<%= runtime.costCurrency || 'USD' %>" maxlength="8">
              </div>
            </div>

            <div id="budget-status" class="mode-callout">Loading current usage…</div>
          </div>
        </div>

        <div class="btn-group">
          <button type="submit" class="btn btn-primary">
            <span id="save-text">Save Changes</span>
            <span id="save-loading" class="loading" style="display: none;"></span>
          </button>
          <button type="button" class="btn btn-secondary" onclick="window.location.reload()">Cancel</button>
        </div>
