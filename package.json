    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "langchain": "^1.1.5",
    "openai": "^6.10.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.18.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
