    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.6.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
