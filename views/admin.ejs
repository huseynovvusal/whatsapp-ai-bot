    // Current spend against the configured ceilings
    async function loadBudget() {
      const host = document.getElementById('budget-status');
      if (!host) return;
      try {
        const res = await fetch('/api/budget');
        const b = await res.json();
        if (!b.dailyTokenLimit && !b.monthlyTokenLimit) {
          host.textContent = 'No limits set. ' + b.tokensToday.toLocaleString() +
            ' tokens used today across ' + b.callsToday.toLocaleString() + ' AI calls.';
          return;
        }
        const cost = b.estimatedCostToday !== null
          ? ' (~' + b.estimatedCostToday + ' ' + b.currency + ' today)' : '';
        const pct = Math.round(b.utilisation * 100);
        host.textContent =
          b.tokensToday.toLocaleString() + ' tokens today' +
          (b.dailyTokenLimit ? ' of ' + b.dailyTokenLimit.toLocaleString() : '') + '; ' +
          b.tokensThisMonth.toLocaleString() + ' this month' +
          (b.monthlyTokenLimit ? ' of ' + b.monthlyTokenLimit.toLocaleString() : '') +
          cost + ' — ' + pct + '% of the tightest limit' +
          (b.exceeded ? '. LIMIT REACHED: the bot is not calling the AI.' : '.');
      } catch (e) {
        host.textContent = 'Could not load usage.';
      }
    }

    // Initialize
    toggleProvider();
    loadBudget();
    loadStats();
    loadBotStatus();
    loadAccessControlMode();
    loadGroupResponseMode();
    setInterval(loadStats, 30000); // Refresh every 30s
    connectWebSocket(); // Connect to WebSocket for real-time logs
  </script>
  <script src="/static/js/analytics.js"></script>
  <script src="/static/js/admin-people.js"></script>
</body>
</html>
