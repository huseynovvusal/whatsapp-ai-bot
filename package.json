{
  "name": "whatsapp-group-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node -r tsconfig-paths/register src/index.ts | pino-pretty -c",
    "start": "prisma migrate deploy && ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "prettier": "prettier --write \"src/**/*.ts\" \"public/js/**/*.js\" \"./*.json\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "dev:docker": "prisma migrate deploy && nodemon --watch src --watch views --ext ts,ejs,js --exec ts-node -r tsconfig-paths/register src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "docker:up:d": "docker compose up -d",
    "docker:prod": "docker compose --profile prod up -d",
    "docker:psql": "docker compose exec db psql -U botuser -d whatsapp_bot"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "openai": "^6.10.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "winston": "^3.18.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.6.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  }
}