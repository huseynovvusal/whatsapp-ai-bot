  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node -r tsconfig-paths/register src/index.ts | pino-pretty -c",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "prettier": "prettier --write \"src/**/*.ts\" \"public/js/**/*.js\" \"./*.json\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "docker:build": "docker build -t whatsapp-ai-bot .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
