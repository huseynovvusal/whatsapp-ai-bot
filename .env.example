# Database (PostgreSQL + pgvector)
# `docker compose up` starts one and sets this for you; this value is for
# running the app directly on the host.
DATABASE_URL=postgresql://botuser:botpass@localhost:5432/whatsapp_bot

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# WhatsApp Bot Configuration
BOT_NAME=@bot
ADMIN_NUMBERS=1234567890,9876543210

# LLM Configuration
LLM_PROVIDER=gemini

# OpenAI (if using OpenAI)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (if using Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Memory Configuration
# Short-term memory: the recent conversation sent with every prompt.
# These are starting values only — both are editable live in the admin UI
# (Settings -> Memory & Recall) and the stored runtime config wins.
# MEMORY_WINDOW_MS: how long a message stays in short-term memory. 0 = never expires.
MEMORY_WINDOW_MS=86400000
# MEMORY_MESSAGE_LIMIT: messages kept per chat. 0 = unlimited.
MEMORY_MESSAGE_LIMIT=50
# Long-range recall is handled by RAG (see the Memory tab in the admin panel)
# rather than by enlarging these, which keeps token cost flat as history grows.

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=2
RATE_LIMIT_WINDOW_MS=60000

# System Prompt
SYSTEM_PROMPT=Your custom system prompt goes here.

# Enable private chat responses (true/false)
ENABLE_PRIVATE_CHAT=false

# Access Control Mode (disabled/whitelist/blacklist)
ACCESS_CONTROL_MODE=disabled

# Admin Panel Authentication
ADMIN_USERNAME=admin
# To generate a password hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$example.hash.here.replace.with.yours
SESSION_SECRET=your-random-secret-key-change-in-production
