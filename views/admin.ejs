    // WebSocket for real-time logs
    let ws = null;
    let autoScroll = true;
    const maxLogs = 500; // Keep last 500 logs

    function connectWebSocket() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/ws`;

      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        console.log('WebSocket connected');
        addLog('success', 'WebSocket connected', 'System');
      };

      ws.onmessage = (event) => {
        const message = JSON.parse(event.data);

        if (message.type === 'log') {
          const log = message.data;
          addLog(log.level, log.message, log.source);
        } else if (message.type === 'qr') {
          const qrData = message.data;
          showQRCode(qrData.qr);
          showQRCodeHome(qrData.qr);
        } else if (message.type === 'connection') {
          const status = message.data;
          updateConnectionStatus(status.connected, status.phoneNumber);
          updateConnectionStatusHome(status.connected, status.phoneNumber);
        }
      };

      ws.onerror = (error) => {
        console.error('WebSocket error:', error);
        addLog('error', 'WebSocket connection error', 'System');
      };

      ws.onclose = () => {
        console.log('WebSocket disconnected, reconnecting in 5s...');
        addLog('warn', 'WebSocket disconnected, reconnecting...', 'System');
        setTimeout(connectWebSocket, 5000);
      };
    }

    function updateLogCount() {
      const el = document.getElementById('log-count');
      if (el) el.textContent = String(document.querySelectorAll('#logs-container .log-entry:not(.log-empty)').length);
    }

    function matchesLogFilters(entry) {
      const levelFilter = (document.getElementById('log-level-filter') || {}).value || 'all';
      const search = ((document.getElementById('log-search') || {}).value || '').toLowerCase().trim();
      const level = entry.getAttribute('data-level') || '';
      const text = (entry.getAttribute('data-text') || '').toLowerCase();
      if (levelFilter !== 'all' && level !== levelFilter) return false;
      if (search && !text.includes(search)) return false;
      return true;
    }

    function applyLogFilters() {
      document.querySelectorAll('#logs-container .log-entry:not(.log-empty)').forEach(entry => {
        entry.classList.toggle('log-hidden', !matchesLogFilters(entry));
      });
    }

    function addLog(level, message, source) {
      const logsContainer = document.getElementById('logs-container');

      // Remove placeholder ("Waiting for logs…") message
      const placeholder = logsContainer.querySelector('.log-empty');
      if (placeholder) placeholder.remove();

      const time = new Date().toLocaleTimeString();
      const sourceText = source ? `[${source}]` : '';

      // Create log entry
      const logEntry = document.createElement('div');
      logEntry.className = `log-entry log-${level}`;
      logEntry.setAttribute('data-level', level);
      logEntry.setAttribute('data-text', `${sourceText} ${message}`);
      logEntry.setAttribute('data-time', time);

      logEntry.innerHTML = `
        <span class="log-time">${time}</span>
        <span class="log-source">${escapeHtml(sourceText)}</span>
        <span class="log-message">${escapeHtml(message)}</span>
      `;

      // Apply current filters immediately so hidden entries stay hidden
      if (!matchesLogFilters(logEntry)) logEntry.classList.add('log-hidden');

      logsContainer.appendChild(logEntry);

      // Limit number of logs
      while (logsContainer.children.length > maxLogs) {
        logsContainer.removeChild(logsContainer.firstChild);
      }

      updateLogCount();

      // Auto scroll to bottom
      if (autoScroll) {
        logsContainer.scrollTop = logsContainer.scrollHeight;
      }
    }

    function downloadLogs() {
      const entries = Array.from(document.querySelectorAll('#logs-container .log-entry:not(.log-empty)'));
      if (!entries.length) { showAlert('error', 'No logs to download'); return; }
      const lines = entries.map(e => {
        const time = e.getAttribute('data-time') || '';
        const level = (e.getAttribute('data-level') || '').toUpperCase();
        const text = e.getAttribute('data-text') || '';
        return `${time} [${level}] ${text}`.trim();
      });
      const blob = new Blob([lines.join('\n')], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `whatsapp-bot-logs-${new Date().toISOString().replace(/[:.]/g, '-')}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

