  <script>
    // CSRF: the panel authenticates with a session cookie, which a browser
    // attaches to cross-site requests too. Every state-changing call must echo
    // this token in a header, which cross-origin JavaScript cannot set.
    window.CSRF_TOKEN = <%- JSON.stringify(csrfToken || "") %>;

    // Wrapped once here rather than at ~28 call sites, so a new fetch cannot
    // accidentally ship without the token.
    (function () {
      const rawFetch = window.fetch.bind(window);
      window.fetch = function (input, init) {
        init = init || {};
        const method = (init.method || 'GET').toUpperCase();
        const url = typeof input === 'string' ? input : (input && input.url) || '';
        const sameOrigin = !/^https?:\/\//i.test(url) || url.startsWith(window.location.origin);
        if (sameOrigin && method !== 'GET' && method !== 'HEAD') {
          const headers = new Headers(init.headers || {});
          if (!headers.has('X-CSRF-Token')) headers.set('X-CSRF-Token', window.CSRF_TOKEN);
          init.headers = headers;
          if (!init.credentials) init.credentials = 'same-origin';
        }
        return rawFetch(input, init);
      };
    })();

    // Tab switching (robust: does not rely on the global `event` object, so it
    // works when invoked programmatically e.g. from the "Manage Lists" button)
    function switchTab(tabName) {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

      const content = document.getElementById('tab-' + tabName);
      if (content) content.classList.add('active');

      const btn = Array.from(document.querySelectorAll('.tabs .tab'))
        .find(t => (t.getAttribute('onclick') || '').includes("switchTab('" + tabName + "')"));
      if (btn) btn.classList.add('active');

      if (tabName === 'conversations') {
        loadConversations();
      } else if (tabName === 'access') {
        loadAccessLists();
      } else if (tabName === 'analytics') {
        // Charts need a measurable width, so they render on first reveal
        if (typeof initAnalyticsTab === 'function') initAnalyticsTab();
      } else if (tabName === 'people') {
        if (typeof loadPeople === 'function') loadPeople();
      } else if (tabName === 'knowledge') {
        if (typeof loadKnowledge === 'function') loadKnowledge();
      }
    }

    // Load stats
    async function loadStats() {
      try {
        const res = await fetch('/api/stats');
        const data = await res.json();

        document.getElementById('stat-messages').textContent = data.totalMessages?.toLocaleString() || '0';
        document.getElementById('stat-users').textContent = data.totalUsers?.toLocaleString() || '0';
        document.getElementById('stat-active-users').textContent = data.activeUsers?.toLocaleString() || '0';
        document.getElementById('stat-conversations').textContent = data.totalConversations?.toLocaleString() || '0';
        document.getElementById('stat-today-messages').textContent = data.today?.totalMessages?.toLocaleString() || '0';
      } catch (err) {
        console.error('Failed to load stats:', err);
      }
    }

    // Load conversations
    async function loadConversations() {
      try {
        const res = await fetch('/api/conversations');
        const data = await res.json();
        const tbody = document.getElementById('conversations-list');

        if (!data.conversations || data.conversations.length === 0) {
          tbody.innerHTML = `
            <tr><td colspan="6">
              <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <p>No conversations yet</p>
              </div>
            </td></tr>`;
          return;
        }

        // Personality overrides, so each row can show the mode actually in force
        let personaInfo = { defaultPersona: 'assistant', overrides: {} };
        try {
          const pRes = await fetch('/api/personas');
          if (pRes.ok) personaInfo = await pRes.json();
        } catch (e) { /* fall back to showing the default everywhere */ }

        tbody.innerHTML = data.conversations.map(c => {
          const isGroup = c.id.includes('@g.us');
          const chatType = isGroup ? 'group' : 'contact';
          const override = personaInfo.overrides[c.id] || '';
          const effective = override || personaInfo.defaultPersona;
          const modeCell = `
            <select class="mode-select" onchange="setChatPersona('${c.id}', this.value)" aria-label="Personality mode">
              <option value="default" ${!override ? 'selected' : ''}>Default (${effective === 'companion' ? 'Companion' : 'Assistant'})</option>
              <option value="assistant" ${override === 'assistant' ? 'selected' : ''}>🎯 Assistant</option>
